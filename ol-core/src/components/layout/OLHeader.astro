---
import { BRAND } from "../../lib/site-config";
import { url } from "../../lib/url";

import '../../styles/layout/home-menu.css';
interface Props { homeMenu?: boolean; homeReader?: boolean }
const { homeMenu = false, homeReader = false } = Astro.props;
const homeLanding = homeMenu && Astro.url.pathname.replace(/\/$/, '') === url('/').replace(/\/$/, '');
---

<header class="ol-header" data-home-header={homeMenu || undefined} data-home-landing-header={homeLanding || undefined}
  data-home-reader-header={homeReader || undefined} data-pagefind-ignore>
  <div class="ol-container ol-header-inner">
    <div class="ol-header-left">
      <div class="ol-header-branding">
        <a href={url("/")} class="ol-brand" aria-label="비움 홈">
          <span class="ol-brand-name">{BRAND.nameKo}</span>
        </a>
        {homeMenu && <span class="ol-home-tagline">붓다의 지혜를 오늘의 삶으로</span>}
      </div>
    </div>

    <!-- Right actions -->
    <div class="ol-header-right">
      <!-- 검색 트리거 -->
      <button
        id="ol-search-trigger"
        class="ol-btn ol-btn-ghost ol-btn-sm ol-btn-icon"
        title="검색 (⌘K)"
        aria-label="검색"
      >
        <svg
          width="15"
          height="15"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <circle cx="11" cy="11" r="8" />
          <line x1="21" y1="21" x2="16.65" y2="16.65" />
        </svg>
      </button>

      <!-- Dark mode toggle -->
      <button
        id="ol-theme-toggle"
        class="ol-btn ol-btn-ghost ol-btn-sm ol-btn-icon"
        title="테마 전환"
        aria-label="다크 모드"
        aria-pressed="false"
      >
        <!-- Sun icon (shown in dark mode) -->
        <svg
          class="ol-icon-sun"
          width="15"
          height="15"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <circle cx="12" cy="12" r="5" />
          <line x1="12" y1="1" x2="12" y2="3" />
          <line x1="12" y1="21" x2="12" y2="23" />
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64" />
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78" />
          <line x1="1" y1="12" x2="3" y2="12" />
          <line x1="21" y1="12" x2="23" y2="12" />
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36" />
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22" />
        </svg>
        <!-- Moon icon (shown in light mode) -->
        <svg
          class="ol-icon-moon"
          width="15"
          height="15"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
        </svg>
      </button>

    </div>
  </div>
</header>
<script>
  const scrollHeader = document.querySelector<HTMLElement>('[data-home-landing-header], [data-home-reader-header]');
  if (scrollHeader) {
    const landing = scrollHeader.hasAttribute('data-home-landing-header');
    let lastY = Math.max(0, window.scrollY);
    let frame = 0;
    window.addEventListener('scroll', () => {
      if (frame) return;
      frame = requestAnimationFrame(() => {
        frame = 0;
        const y = Math.max(0, window.scrollY);
        const nearTop = y <= (landing ? 8 : scrollHeader.offsetHeight);
        if (!nearTop && Math.abs(y - lastY) < 5) return;
        scrollHeader.toggleAttribute('data-scroll-hidden', !nearTop && y > lastY);
        lastY = y;
      });
    }, { passive: true });
    window.addEventListener('pageshow', () => {
      lastY = Math.max(0, window.scrollY);
      scrollHeader.removeAttribute('data-scroll-hidden');
    });
  }

  const btn = document.getElementById("ol-theme-toggle");
  btn?.setAttribute("aria-pressed", String(document.documentElement.classList.contains("dark")));
  btn?.addEventListener("click", () => {
    const root = document.documentElement;
    root.classList.add("theme-switching");
    const isDark = root.classList.toggle("dark");
    btn.setAttribute("aria-pressed", String(isDark));
    try { localStorage.setItem("ol-theme", isDark ? "dark" : "light"); } catch { /* Keep the theme for this page. */ }
    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        root.classList.remove("theme-switching");
      });
    });
  });
</script>
