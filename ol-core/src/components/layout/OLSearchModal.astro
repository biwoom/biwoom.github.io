---
import { searchPaths, searchSections, searchSectionLabels } from '../../lib/search.mjs';
import { url } from '../../lib/url';
---

<!-- 오버레이 -->
<div
  class="ol-search-overlay"
  id="ol-search-overlay"
  hidden
  inert
  aria-hidden="true"
  data-pagefind-path={url(searchPaths.pagefind)}
  data-search-catalog={url(searchPaths.catalog)}
  data-search-originals={url(searchPaths.originals)}
  data-pagefind-ignore
>
  <div
    class="ol-search-modal"
    role="dialog"
    aria-modal="true"
    aria-label="검색"
  >
    <!-- 검색 입력 -->
    <div class="ol-search-input-wrap">
      <svg
        class="ol-search-icon"
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
      >
        <circle cx="11" cy="11" r="8" />
        <line x1="21" y1="21" x2="16.65" y2="16.65" />
      </svg>
      <input
        id="ol-search-input"
        class="ol-search-input"
        type="text"
        aria-label="검색어"
        placeholder="검색어 입력..."
        autocomplete="off"
      />
      <kbd class="ol-search-kbd">ESC</kbd>
    </div>

    <div class="ol-search-filters" data-search-filters role="group" aria-label="검색 결과 유형" hidden>
      <button type="button" class="ol-search-filter ol-search-body-toggle" data-search-body aria-pressed="false">
        본문 검색
      </button>
      <button type="button" class="ol-search-filter active" data-search-section="ALL" aria-pressed="true">전체</button>
      {searchSections.map(section => (
        <button type="button" class="ol-search-filter" data-search-section={section} aria-pressed="false">
          {searchSectionLabels[section]}
        </button>
      ))}
    </div>

    <!-- 결과 영역 -->
    <div class="ol-search-results" id="ol-search-results">
      <div class="ol-search-empty" role="status">검색어를 입력하세요</div>
    </div>

    <!-- 하단 힌트 -->
    <div class="ol-search-footer">
      <span>
        <kbd>↑</kbd>
        <kbd>↓</kbd> 이동
      </span>
      <span>
        <kbd>Enter</kbd> 열기
      </span>
      <span>
        <kbd>ESC</kbd> 닫기
      </span>
    </div>
  </div>
</div>

<script>
  import { initSearchModal } from '../../lib/client/search-modal';
  initSearchModal();
</script>
