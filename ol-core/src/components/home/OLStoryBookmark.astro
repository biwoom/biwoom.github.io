---
interface Props { id: string; title: string }
const { id, title } = Astro.props;
---
<button type="button" class="ol-story-bookmark" data-story-bookmark={id} data-story-title={title}
  aria-label={`${title} 보관함에 담기`} aria-pressed="false" title="보관함에 담기">
  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.55" stroke-linejoin="round" aria-hidden="true">
    <path d="M6 5a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v15l-6-4-6 4Z" />
  </svg>
</button>

<script>
  import '../../lib/client/story-bookmarks';
</script>
