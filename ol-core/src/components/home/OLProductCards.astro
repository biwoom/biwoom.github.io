---
import { getDocuments } from "../../lib/library";
import { getHomeArticles } from "../../lib/home-articles";
import { getCollection } from "astro:content";
import { url } from "../../lib/url";
import { LIBRARY_LABELS } from "../../lib/site-config";
const counts = await Promise.all([
  getDocuments("text").then(entries => entries.filter(entry => entry.data.kind !== "series").length),
  getDocuments("story").then(entries => entries.filter(entry => entry.data.kind !== "series").length),
  getCollection("blog", (e) => e.data.published && e.data.kind === "document").then(entries => entries.length),
  getHomeArticles().then(articles => articles.length),
]);
const cards = [
  { name: LIBRARY_LABELS.text, href: "/text/", description: "문헌별 번역·연구·시각자료" },
  { name: LIBRARY_LABELS.story, href: "/story/", description: "붓다와 고승의 전기, 본생담과 설화, 순례기와 게송" },
  {
    name: "틈과 여백",
    href: "/blog/series/",
    description: "사유의 길에 작은 틈을 내고, 일상의 여백을 모읍니다.",
  },
  { name: "이야기 아티클", href: "/articles/", description: "삽화와 함께 읽는 짧은 불교 이야기" },
];
---

<section class="ol-section">
  <div class="ol-container">
    <div class="ol-section-head">
      <span class="ol-section-label">READ · BIWOOM</span>
      <h2 class="ol-kr">비움이 만드는 불교콘텐츠</h2>
      <p>자료를 다시 이용할 때는 <a href={url('/pages/brand/#공개-자료와-이용-조건')}>공개 자료의 이용 조건</a>을 확인해 주세요.</p>
    </div>
    <div class="ol-grid-4">
      {cards.map((card, i) => (
        <a href={url(card.href)} class="ol-product-card">
          <h3>{card.name}</h3>
          <p class="ol-kr">{card.description}</p>
          <div class="ol-product-foot">
            <span class="ol-meta-badge">
              {counts[i]}개 자료
            </span>
            <span>→</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
