---
import { url } from '../../lib/url';
import { BRAND } from '../../lib/site-config';
---
<section class="ol-hero ol-grid-bg ol-grid-bg--home">
  <div class="ol-container">
    <h1 class="ol-kr">
      <em>{BRAND.name}</em>
    </h1>
    <p class="ol-lead ol-kr">
      {BRAND.description}
    </p>
    <div class="ol-hero-actions">
      <a href={url('/text')} class="ol-btn ol-btn-accent">
        불교경론 보기
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M7 17 17 7"/><path d="M7 7h10v10"/>
        </svg>
      </a>
      <a href={url('/story')} class="ol-btn ol-btn-outline">불전문학 보기
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M7 17 17 7"/><path d="M7 7h10v10"/>
        </svg>
      </a>
      <a href={url('/blog')} class="ol-btn ol-btn-outline">틈과 여백 보기
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M7 17 17 7"/><path d="M7 7h10v10"/>
        </svg>
      </a>
    </div>
  </div>
</section>
