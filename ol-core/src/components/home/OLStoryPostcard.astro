---
import { storyCategories, type HomeArticle } from '../../lib/home-articles';
import { homeTopicTagId } from '../../../scripts/lib/home-articles.mjs';
import { url } from '../../lib/url';
import OLStoryBookmark from './OLStoryBookmark.astro';

interface Props { story: HomeArticle; featured?: boolean; direct?: boolean; rank?: number; hidden?: boolean }
const { story, featured = false, direct = false, rank, hidden = false } = Astro.props;
const topicTags = story.storyTags.filter(tag => tag.type === 'topic');
---
<article class:list={['ol-postcard', { 'ol-postcard-featured': featured }]} hidden={hidden} data-tone={story.topic} data-story-card={story.id}
  data-story-topic={story.topic} data-story-category={story.category}
  data-story-title={story.title} data-story-published-at={story.publishedAt} data-story-created-at={story.createdAt} data-story-rank={rank}
  data-story-topic-tags={topicTags.map(tag => homeTopicTagId(tag.label)).join(' ')}
  data-story-search={[story.title, story.topicLabel, storyCategories[story.category], story.series, story.blurb, ...topicTags.flatMap(tag => [tag.label, ...tag.aliases])].filter(Boolean).join(' ')}>
  <a class="ol-postcard-link" href={url(`/stories/${story.id}/`)} aria-label={story.title}
    data-home-detail-open={direct ? undefined : story.id} aria-controls={direct ? undefined : 'ol-home-detail'} aria-expanded={direct ? undefined : 'false'}>
    {featured && <div class="ol-postcard-feature-meta"><span>{story.topicLabel}</span><span>{story.minutes}분 읽기</span></div>}
    <div class="ol-postcard-copy">
      {!featured && <span class="ol-postcard-topic">{story.topicLabel}</span>}
      <h3>{story.title}</h3>
      <p>{story.blurb}</p>
      {featured ? <span class="ol-postcard-feature-read">이야기 읽기 <span aria-hidden="true">→</span></span> : <span class="ol-postcard-time">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="12" cy="12" r="8.6"/><path d="M12 7v5l3 2"/></svg>
        {story.minutes}분
      </span>}
    </div>
  </a>
  <OLStoryBookmark id={story.id} title={story.title} />
</article>
