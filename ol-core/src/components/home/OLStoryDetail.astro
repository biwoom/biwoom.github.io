---
import type { HomeArticle } from '../../lib/home-articles';
import OLStoryDetailTemplate from './OLStoryDetailTemplate.astro';
interface Props { stories: HomeArticle[] }
const { stories } = Astro.props;
---
<dialog class="ol-home-detail" id="ol-home-detail" aria-labelledby="ol-home-detail-title" data-home-story-detail>
  <div class="ol-home-detail-inner">
    <div class="ol-home-detail-top">
      <span>이야기 상세</span>
      <form method="dialog"><button type="submit" class="ol-btn ol-btn-ghost ol-btn-sm">닫기</button></form>
    </div>
    <div data-home-detail-body></div>
  </div>
</dialog>
{stories.map(story => <OLStoryDetailTemplate story={story} />)}
<script>
  import '../../lib/client/home-story-detail';
</script>
