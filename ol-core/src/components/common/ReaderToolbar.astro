---
import type { Library } from "../../lib/library";
import ReaderCopyControl from './ReaderCopyControl.astro';
import ReaderFontControl from './ReaderFontControl.astro';
interface Props { hasToc: boolean; hasOriginal?: boolean; currentUrl: string; title: string; currentPart?: Library["parts"][number]; academic?: boolean; }
const { hasToc, hasOriginal = false, currentUrl, title, academic = false } = Astro.props;
---
          <div class="ol-reader-toolbar">
            <div class="ol-reader-navigation-tools">
            <button class="ol-text-tool-btn ol-text-list-trigger" type="button" data-text-left-toggle={academic ? true : undefined} data-story-left-toggle={!academic ? true : undefined} aria-expanded="false" aria-controls={academic ? "text-document-list" : "story-document-list"}><span class="ol-text-tool-symbol" aria-hidden="true">☷</span><span class="ol-text-list-label-wide">문헌 목차</span><span class="ol-text-list-label-compact">문헌</span></button>
            {hasOriginal && <button class="ol-text-tool-btn ol-original-toggle" type="button" data-original-toggle aria-pressed="false" aria-label="원문 숨기기" title="원문 숨기기">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/><path d="m3 3 18 18" data-original-slash /></svg>
              <span data-original-label>원문 숨기기</span>
            </button>}
            </div>
            <div class="ol-story-part-tools">
                <button class="ol-text-tool-btn ol-reader-toc-trigger" type="button"
                  aria-label="본문 목차 열기" title={hasToc ? "본문 목차" : "목차없음"} aria-haspopup="dialog"
                  aria-expanded="false" aria-controls="ol-reader-toc" data-reader-toc-trigger>
                  <span class="ol-text-tool-symbol" aria-hidden="true">≡</span>
                  <span class="ol-text-tool-label ol-reader-toc-label">{academic && <span class="ol-reader-toc-prefix">본문{' '}</span>}목차</span>
                </button>
              <button class="ol-text-tool-btn" type="button" disabled
                aria-label="각주 없음" title="각주 없음" aria-haspopup="dialog"
                aria-expanded="false" aria-controls="ol-reader-footnotes" data-reader-footnotes-trigger>
                <span class="ol-text-tool-symbol" aria-hidden="true">:</span>
                <span class="ol-text-tool-label ol-reader-footnotes-label">각주</span>
              </button>
              <ReaderFontControl showLabel={academic} />
              <ReaderCopyControl {currentUrl} {title} {academic} label={academic ? '복사' : 'Copy'} />
              <button class="ol-text-tool-btn" type="button" data-text-focus={academic ? true : undefined} data-story-focus={!academic ? true : undefined} aria-pressed="false" aria-label={!academic ? "집중 모드" : undefined} title={!academic ? "집중 모드" : undefined} aria-controls={!academic ? "story-document-list" : undefined}><span class="ol-text-tool-symbol" aria-hidden="true">⛶</span><span data-text-focus-label>집중</span></button>
            </div>

          </div>

<p class="ol-reader-feedback" role="status" aria-live="polite" data-reader-feedback></p>

<button class="ol-reader-back-to-top" type="button" data-reader-back-to-top aria-label="맨 위로 이동" title="맨 위로 이동" hidden>
  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 19V5m-7 7 7-7 7 7" /></svg>
</button>
