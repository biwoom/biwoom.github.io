---
import { url } from "../../lib/url";
import BaseLayout from '../../layouts/BaseLayout.astro';
import TextBibliography from './TextBibliography.astro';
import TextMaterialList from './TextMaterialList.astro';
import { categoryUrl, type Library } from '../../lib/library';
import { textMaterialCatalogUrl, textMaterialPageSize, textMaterialPageUrl, usesSeparateMaterialLists, type TextPart } from '../../lib/text-materials';
interface Props { series: Library; materials?: { part: TextPart; page: number; total: number }; }
const { series, materials } = Astro.props;
const first = series.entries[0];
const intro = await Astro.slots.render("default");
const hasIntro = !!intro.replace(/<[^>]*>/g, "").trim();
const separate = usesSeparateMaterialLists(series);
const start = materials ? (materials.page - 1) * textMaterialPageSize : 0;
const title = materials ? `${materials.part.label} 자료 목록 · ${series.label} · ${materials.page}/${materials.total}` : series.label;
---
<BaseLayout title={`${title} · TEXT`} description={series.description} pagefindBody={false} academic>
  <main class="ol-text-academic ol-text-library">
    <header class="ol-container ol-text-work-head">
      <nav class="ol-text-crumb" aria-label="현재 위치"><a href={url("/text/")}>TEXT</a>{series.category && <><span>/</span><a href={url(categoryUrl(series.categoryKey))}>{series.category}</a></>}</nav>
      <div class="ol-text-work-title"><div><span class="ol-text-eyebrow">TEXT · 문헌</span><h1>{materials ? `${materials.part.label} 자료 목록` : series.label}</h1>{!materials && series.description && <p>{series.description}</p>}</div>
        {materials ? <a class="ol-text-primary" href={url(series.url)}>← {series.label} 문헌 정보</a>
          : first && <a class="ol-text-primary" href={url(first.data.url)}>{series.parts[0]?.label} 읽기 <span aria-hidden="true">→</span></a>}
      </div>
      {!separate && <nav class="ol-text-parts" aria-label="자료 구분">{series.parts.map((part, i) => <a href={url(part.entries[0].data.url)}><span>{String(i + 1).padStart(2, '0')}</span><strong>{part.label}</strong><small>{part.entries.length}</small></a>)}</nav>}
    </header>
    <div class="ol-container ol-text-library-grid">
      <aside class="ol-text-library-nav" aria-label="문헌 안내"><h2>문헌 안내</h2><a href={materials ? url(series.url) + "#text-materials" : "#text-materials"}>{materials ? "전체 자료 목록" : "자료 목록"}</a>{hasIntro && <a href="#text-intro">서지정보</a>}
        {!separate && <><h3>자료 구분</h3>{series.parts.map((part, i) => <a href={`#text-group-${i}`}>{part.label}<small>{part.entries.length}개</small></a>)}</>}
        <p>번역과 연구는 독립된 자료입니다. 각 자료의 목차를 따라 읽어 보세요.</p>
      </aside>
      <section class="ol-text-library-main" id="text-materials">
        <div class="ol-text-section-head"><h2>자료 목록</h2><span>{(materials?.part.entries.length ?? series.count)}개 자료</span></div>
        {!materials && series.count > 0 && <form class="ol-text-filter" role="search" data-text-material-catalog={separate ? url(textMaterialCatalogUrl(series)) : undefined} data-page-size={separate ? textMaterialPageSize : undefined} hidden={separate} inert={separate}><label for="text-material-search">자료 찾기</label><div><input type="search" id="text-material-search" placeholder="자료 제목·설명 검색" autocomplete="off" /><button type="button" data-text-search-reset>초기화</button></div><p class="ol-text-search-status" role="status" aria-live="polite" data-text-search-status>{series.count}개 자료</p></form>}
        {materials ? (
          <div class="ol-text-material-group" data-text-material-page>
            <TextMaterialList entries={materials.part.entries.slice(start, start + textMaterialPageSize)} {start} />
            {materials.total > 1 && <nav class="ol-text-material-pages" aria-label="자료 목록 페이지">
              {materials.page > 1 && <a href={url(textMaterialPageUrl(series, materials.part, materials.page - 1))} rel="prev">← 이전</a>}
              <span>{materials.page} / {materials.total}</span>
              {materials.page < materials.total && <a href={url(textMaterialPageUrl(series, materials.part, materials.page + 1))} rel="next">다음 →</a>}
            </nav>}
          </div>
        ) : separate ? (
          <>
            <div class="ol-text-material-group" data-text-material-directory>
              <ol class="ol-text-material-rows">
                {series.parts.map((part, i) => <li id={`text-group-${i}`}><a href={url(textMaterialPageUrl(series, part, 1))}><span class="ol-text-row-num">{String(i + 1).padStart(2, '0')}</span><div><strong>{part.label}</strong><p>{part.entries.length}개 자료</p></div><span aria-hidden="true">→</span></a></li>)}
              </ol>
            </div>
            <div class="ol-text-material-group" data-text-material-results hidden>
              <ol class="ol-text-material-rows" data-text-material-matches></ol>
              <nav class="ol-text-material-pages" aria-label="자료 검색 결과 페이지" data-text-result-pages hidden>
                <button type="button" data-text-result-prev>← 이전</button><span data-text-result-page></span><button type="button" data-text-result-next>다음 →</button>
              </nav>
            </div>
          </>
        ) : series.parts.map((part, i) => <details class="ol-text-material-group" id={`text-group-${i}`} open={i === 0} data-text-material-group>
          <summary><span>{String(i + 1).padStart(2, '0')}</span><strong>{part.label}</strong><small data-text-group-count>{part.entries.length}개 자료</small></summary>
          <TextMaterialList entries={part.entries} filterable />
        </details>)}
        <p class="ol-text-search-empty" data-text-search-empty hidden>일치하는 자료가 없습니다.</p>
        {series.count === 0 && <p>아직 공개된 자료가 없습니다.</p>}
      </section>
      {!materials && <TextBibliography series={series}><Fragment set:html={intro} /></TextBibliography>}
    </div>
  </main>
</BaseLayout>
<script>
  import { initTextLibrary } from '../../lib/client/text-library';
  initTextLibrary();
</script>
