---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCategories, getLibrary } from "../../lib/library";
import type { Category, Section } from "../../lib/library";
import { url } from "../../lib/url";
interface Props {
  section: Section;
  category?: Category;
}
const { section, category } = Astro.props;
const library = category?.series ?? await getLibrary(section);
const categories = category ? [] : getCategories(section, library);
const label = section.toUpperCase();
---

<BaseLayout
  title={category ? `${category.label} — Biwoom ${label}` : `Biwoom ${label}`}
  description={category
    ? category.description || `${category.label}의 ${section === "text" ? "문헌" : "이야기"} 시리즈`
    : section === "text" ? "불교 문헌의 번역·연구·시각자료" : "불교의 인물과 가르침을 만나는 이야기"}
  pagefindBody={false}
>
  <main class="ol-library-index-page">
    <section class:list={[
      "ol-hero ol-hero--compact",
      category && "ol-library-category-hero",
      !category && `ol-library-menu-hero ol-grid-bg ol-grid-bg--${section}`,
    ]}>
      <div class="ol-container">
        {category ? (
          <nav class="ol-text-breadcrumb" aria-label="현재 위치">
            <a href={url(`/${section}/`)}>{label}</a><span>/</span><span>{category.label}</span>
          </nav>
        ) : <span class="ol-section-label">Biwoom {label}</span>}
        <h1 class="ol-kr">{category?.label ?? (section === "text" ? "불교 문헌을 읽고 연구하다." : "이야기로 만나는 불교.")}</h1>
        <p class="ol-lead ol-kr">
          {category ? `${category.series.length}개 시리즈 · ${category.count}개 자료`
            : section === "text" ? "카테고리를 선택해 문헌별 번역과 연구, 시각자료를 살펴보세요."
            : "카테고리를 선택해 붓다와 고승의 생애, 가르침과 전승, 구법의 여정과 게송을 만나보세요."}
        </p>
        {category?.description && <p class="ol-lead ol-kr">{category.description}</p>}
      </div>
    </section>
    <section class="ol-section" aria-labelledby="ol-library-list-label">
      <div class="ol-container">
        <p class="ol-library-list-label" id="ol-library-list-label">{category ? "시리즈 목록" : "카테고리 목록"}</p>
        <div class:list={category ? "ol-library-series-list" : "ol-grid-3"} data-library-grid data-library-view={category ? "series" : "categories"}>
          {category ? library.map((series, index) => (
            <a class="ol-library-series-row" href={url(series.url)} data-library-item>
              <span class="ol-library-series-number" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
              <div class="ol-library-series-body">
                <h2 class="ol-kr">{series.label}</h2>
                {series.description && <p class="ol-kr">{series.description}</p>}
                <div class="ol-library-series-meta">
                  <span>{series.count}개 자료</span>
                  {series.parts.length > 0 && <span>{series.parts.map((part) => part.label).join(" · ")}</span>}
                </div>
              </div>
              <svg class="ol-library-series-arrow" width="20" height="20" viewBox="0 0 24 24"
                fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M4 12h16m-6-6 6 6-6 6" />
              </svg>
            </a>
          )) : categories.map((item) => (
            <a class="ol-card ol-story-library-card" href={url(item.url)} data-library-item data-library-category={item.key}>
              <span class="ol-meta-label">{label} CATEGORY</span>
              <h2 class="ol-kr">{item.label}</h2>
              {item.description && <p class="ol-kr">{item.description}</p>}
              <span class="ol-meta-label">{item.series.length}개 시리즈 · {item.count}개 자료</span>
            </a>
          ))}
        </div>
        <div class="ol-loadmore-wrap" data-library-more hidden>
          <button type="button" class="ol-btn ol-btn-ghost" data-library-more-button>
            더 보기 <span data-library-remaining></span>
          </button>
        </div>
        {(category ? library.length === 0 : categories.length === 0) && <p>준비 중입니다.</p>}
      </div>
    </section>
  </main>
</BaseLayout>
<script>
  import { createPaginator } from "../../lib/client/paginated-list";
  createPaginator({
    allItems: [...document.querySelectorAll<HTMLElement>("[data-library-item]")],
    pageSize: 9,
    loadMoreWrap: document.querySelector("[data-library-more]"),
    loadMoreButton: document.querySelector("[data-library-more-button]"),
    loadMoreRemaining: document.querySelector("[data-library-remaining]"),
  }).reset();
</script>
