---
interface Props { showLabel?: boolean }
const { showLabel = false } = Astro.props;
---
<div class="ol-reader-font" data-reader-font>
  <button class="ol-text-tool-btn" type="button" aria-label="글자 크기 조절" title="글자 크기 조절"
    aria-expanded="false" aria-controls="ol-reader-font-panel" data-reader-font-trigger>
    <span class="ol-text-tool-symbol" aria-hidden="true">Aa</span>
    {showLabel && <span class="ol-text-tool-label">글자</span>}
  </button>
  <div id="ol-reader-font-panel" class="ol-reader-font-panel" hidden>
    <div class="ol-reader-font-field">
      <div class="ol-reader-font-caption">
        <label class="label" for="ol-reader-font-size">글자 크기</label>
        <output for="ol-reader-font-size" data-reader-font-value>100%</output>
      </div>
      <input id="ol-reader-font-size" class="input w-full" type="range" min="80" max="150" step="5" value="100" data-reader-font-size />
    </div>
    <div class="ol-reader-font-actions">
      <button type="button" data-reader-font-reset>초기화</button>
      <button type="button" data-reader-font-close>닫기</button>
    </div>
  </div>
</div>
