---
interface Props { id: string }
const { id } = Astro.props;
const titleId = `${id}-title`;
---
<dialog id={id} class="ol-text-list-dialog" aria-labelledby={titleId} data-pagefind-ignore>
  <div class="ol-reader-list-panel">
    <header class="ol-reader-toc-head">
      <h2 id={titleId} tabindex="-1" autofocus>문헌 목차</h2>
      <button type="button" class="ol-text-tool-btn" aria-label="문헌 목차 닫기" data-reader-list-close>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 6 12 12M6 18 18 6" /></svg>
      </button>
    </header>
    <div data-reader-mobile-list-slot></div>
  </div>
</dialog>
