---
import type { Entry } from "../../lib/library";
interface Props {
  entry: Entry;
}
const { entry } = Astro.props;
const { data } = entry;
const asset =
  "/generated/content/" +
  data.source.split("/").map(encodeURIComponent).join("/");
---

{data.format ? (
  <>
    <p>
      <a
        class="ol-btn ol-btn-primary"
        href={asset}
        target="_blank"
        rel="noopener"
      >
        {data.format} 열기 ↗
      </a>{" "}
      <a class="ol-btn ol-btn-ghost" href={asset} download>
        다운로드
      </a>
    </p>
    {["PNG", "JPG", "JPEG", "WEBP", "GIF", "SVG"].includes(data.format) && (
      <img src={asset} alt={data.title} />
    )}
  </>
) : (
  <slot />
)}
