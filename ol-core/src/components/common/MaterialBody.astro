---
import type { Entry } from "../../lib/library";
import { assetUrl } from "../../../scripts/remark-content.mjs";
import { url } from "../../lib/url";
interface Props {
  entry: Entry;
}
const { entry } = Astro.props;
const { data } = entry;
const asset = url(assetUrl(data.source));
---

{data.format ? (
  <>
    <p>
      <a
        class="ol-btn ol-btn-primary"
        href={asset}
        target="_blank"
        rel="noopener"
      >
        {data.format} 열기 ↗
      </a>{" "}
      <a class="ol-btn ol-btn-ghost" href={asset} download>
        다운로드
      </a>
    </p>
    {["PNG", "JPG", "JPEG", "WEBP", "GIF", "SVG"].includes(data.format) && (
      <img src={asset} alt={data.title} />
    )}
  </>
) : (
  <slot />
)}
