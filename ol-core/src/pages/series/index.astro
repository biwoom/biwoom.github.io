---
import OLHomeShell from '../../components/home/OLHomeShell.astro';
import { getHomeArticles, getHomeSeries, storyCategories } from '../../lib/home-articles';
import { url } from '../../lib/url';

const articles = await getHomeArticles();
const series = await getHomeSeries(articles);
const categories = Object.entries(storyCategories).map(([id, label]) => ({
  id, label, count: articles.filter(story => story.category === id).length,
}));
---
<OLHomeShell title="이야기 시리즈">
  <header slot="intro" class="ol-home-intro">
    <h1>시리즈와 이야기 묶음</h1>
    <p>한 인물과 주제를 따라 이야기를 이어 읽습니다.</p>
  </header>
  <div class="ol-blog-series-grid ol-home-series-grid">
    {series.map(({ path, title, category, stories, description }, index) => (
      <a href={url(path)} class="ol-blog-series-card" data-home-series-card data-tone={1 + index % 4}>
        <span class="ol-blog-cover-art" aria-hidden="true"></span>
        <div class="ol-blog-cover-line"><span>{storyCategories[category]}</span><span>{stories.length ? `${stories.length}편` : '준비 중'}</span></div>
        <div class="ol-blog-cover-copy">
          <h2>{title}</h2>
          {description && <p>{description}</p>}
          <span class="ol-home-series-arrow" aria-hidden="true">↗</span>
        </div>
      </a>
    ))}
  </div>
  {series.length === 0 && <p>등록된 시리즈가 없습니다.</p>}
  <section class="ol-home-category-section" id="categories" aria-labelledby="ol-home-categories-title">
    <h2 id="ol-home-categories-title">이야기 묶음</h2>
    <div class="ol-home-topic-tiles">
      {categories.map(({ id, label, count }) => (
        <a class="ol-home-topic-tile" data-home-category-link href={url(`/categories/${id}/`)}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h6l2 2h10v11H3V6zm0 5h18" /></svg>
          <strong>{label}</strong><span>{count}편</span>
        </a>
      ))}
    </div>
  </section>
</OLHomeShell>
