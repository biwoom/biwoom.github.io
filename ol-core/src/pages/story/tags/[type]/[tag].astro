---
import type { GetStaticPaths } from "astro";
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import { getStoryTags, storyTagTypeLabels } from "../../../../lib/story-tags";
import { url } from "../../../../lib/url";
import { storyTagsPath } from "../../../../../scripts/lib/story-tags.mjs";

export const getStaticPaths = (async () => (await getStoryTags()).map(item => ({
  params: { type: item.type, tag: item.label },
  props: { item },
}))) satisfies GetStaticPaths;

const { item } = Astro.props;
const series = Map.groupBy(item.documents, document => document.seriesKey);
---

<BaseLayout title={`${item.label} · ${storyTagTypeLabels[item.type]} 태그 — BIWOOM HUB`} pagefindBody={false}>
  <main class="ol-section">
    <div class="ol-container ol-prose">
      <nav class="ol-text-breadcrumb" aria-label="현재 위치">
        <a href={url("/story/")}>STORY</a><span>/</span>
        <a href={url(storyTagsPath)}>태그</a><span>/</span>
        <span>{storyTagTypeLabels[item.type]}</span>
      </nav>
      <h1>{item.label}</h1>
      <p>{item.documents.length}편의 이야기</p>
      {item.aliases.length > 0 && <p>이칭 · {item.aliases.join(", ")}</p>}
      <div data-story-tag-results>
        {[...series.values()].map(documents => (
          <section>
            <h2><a href={url(documents[0].seriesUrl)}>{documents[0].series}</a></h2>
            <ul>{documents.map(document => <li><a href={url(document.url)} data-story-tag-document>{document.title}</a></li>)}</ul>
          </section>
        ))}
      </div>
      <template data-story-tag-preview-fragment>
        <div class="ol-tag-preview-heading">
          <span>{storyTagTypeLabels[item.type]} · {item.documents.length}편</span>
          <h2>{item.label}</h2>
        </div>
        {item.aliases.length > 0 && <p class="ol-tag-aliases">이칭 · {item.aliases.join(", ")}</p>}
        <h3>관련 이야기</h3>
        <ul class="ol-tag-preview-links">
          {item.documents.slice(0, 4).map(document => (
            <li>
              <a href={url(document.url)}>{document.title}</a>
              <span class="ol-tag-preview-series">{document.series}</span>
            </li>
          ))}
        </ul>
      </template>
    </div>
  </main>
</BaseLayout>
