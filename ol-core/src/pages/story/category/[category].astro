---
import LibraryIndex from "../../../components/common/LibraryIndex.astro";
import { getCategories, getLibrary } from "../../../lib/library";
export async function getStaticPaths() {
  const library = await getLibrary("story");
  return getCategories("story", library).map((category) => ({
    params: { category: category.url.split("/").at(-2) },
    props: { category },
  }));
}
const { category } = Astro.props;
---
<LibraryIndex section="story" category={category} />
