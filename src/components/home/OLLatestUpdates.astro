---
import { getCollection } from "astro:content";
import { url } from "../../lib/url";

const recentPosts = (await getCollection("blog", (e) => e.data.published))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);

function formatDate(date: Date): string {
  return date
    .toLocaleDateString("ko-KR", {
      year: "numeric",
      month: "2-digit",
      day: "2-digit",
    })
    .replace(/\. /g, ".")
    .replace(/\.$/, "");
}
---

<section class="ol-section">
  <div class="ol-container">
    <div class="ol-row ol-latest-head">
      <div>
        <span class="ol-section-label">LATEST · 최근 소식</span>
        <h2 class="ol-latest-title ol-kr">최근 업데이트</h2>
      </div>
      <div class="ol-spacer"></div>
      <a href={url("/blog")} class="ol-btn ol-btn-ghost ol-btn-sm">
        전체 보기 →
      </a>
    </div>

    {recentPosts.length > 0 ? (
      <div class="ol-grid-3">
        {recentPosts.map((post) => (
          <a href={post.data.url} class="ol-card ol-card-tight ol-latest-card">
            <span class="ol-meta-label">
              {formatDate(post.data.date)}
              {post.data.category ? ` · ${post.data.category}` : ""}
            </span>
            <h4 class="ol-latest-card-title ol-kr">{post.data.title}</h4>
            {post.data.description && (
              <p class="ol-latest-card-copy ol-kr">{post.data.description}</p>
            )}
          </a>
        ))}
      </div>
    ) : (
      <p>아직 공개된 글이 없습니다.</p>
    )}
  </div>
</section>
