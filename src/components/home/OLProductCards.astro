---
import { getDocuments } from "../../lib/library";
import { getCollection } from "astro:content";
const counts = await Promise.all([
  getDocuments("text"),
  getDocuments("story"),
  getCollection("blog", (e) => e.data.published),
]);
const cards = [
  { name: "TEXT", description: "문헌별 번역·연구·시각자료를 함께 읽습니다." },
  { name: "STORY", description: "인물과 설화, 가르침을 이야기로 만납니다." },
  {
    name: "BLOG",
    description: "콘텐츠를 만들고 고쳐가는 과정과 생각을 기록합니다.",
  },
];
---

<section class="ol-section">
  <div class="ol-container">
    <div class="ol-section-head">
      <span class="ol-section-label">READ · OL</span>
      <h2 class="ol-kr">OL이 만드는 불교콘텐츠</h2>
      <p>자료별 출처와 이용 조건을 확인해 주세요.</p>
    </div>
    <div class="ol-grid-3">
      {cards.map((card, i) => (
        <a href={`/${card.name.toLowerCase()}/`} class="ol-product-card">
          <span class="ol-meta-label">
            0{i + 1} / {card.name}
          </span>
          <h3>OL {card.name}</h3>
          <p class="ol-kr">{card.description}</p>
          <div class="ol-product-foot">
            <span class="ol-meta-badge">
              {counts[i].filter((e) => e.data.kind !== "series").length}개 자료
            </span>
            <span>→</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
