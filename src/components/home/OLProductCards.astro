---
import { getDocuments } from "../../lib/library";
import { getCollection } from "astro:content";
import { url } from "../../lib/url";
const counts = await Promise.all([
  getDocuments("text"),
  getDocuments("story"),
  getCollection("blog", (e) => e.data.published),
]);
const cards = [
  { name: "불교경론", href: "/text/", description: "문헌별 번역·연구·시각자료" },
  { name: "불전문학", href: "/story/", description: "부처님 전기, 고승들의 설화, 선시(禪詩)" },
  {
    name: "소소한 글",
    href: "/blog/",
    description: "콘텐츠 제작과정과 소소한 일상",
  },
];
---

<section class="ol-section">
  <div class="ol-container">
    <div class="ol-section-head">
      <span class="ol-section-label">READ · Biwoom</span>
      <h2 class="ol-kr">비움이 만드는 불교콘텐츠</h2>
      <p>비움의 모든 자료는 CC0 라이선스를 따릅니다.</p>
    </div>
    <div class="ol-grid-3">
      {cards.map((card, i) => (
        <a href={url(card.href)} class="ol-product-card">
          <span class="ol-meta-label">
            0{i + 1} / {card.name}
          </span>
          <h3>{card.name}</h3>
          <p class="ol-kr">{card.description}</p>
          <div class="ol-product-foot">
            <span class="ol-meta-badge">
              {counts[i].filter((e) => e.data.kind !== "series").length}개 자료
            </span>
            <span>→</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
