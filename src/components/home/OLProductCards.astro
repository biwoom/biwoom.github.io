---
import { getDocuments } from "../../lib/library";
import { getCollection } from "astro:content";
import { url } from "../../lib/url";
const counts = await Promise.all([
  getDocuments("text"),
  getDocuments("story"),
  getCollection("blog", (e) => e.data.published),
]);
const cards = [
  { name: "불교경론", href: "/text/", description: "문헌별 번역·연구·시각자료를 함께 읽습니다." },
  { name: "불전문학", href: "/story/", description: "인물과 설화, 선시(禪詩) 등을 만납니다." },
  {
    name: "소소한글",
    href: "/blog/",
    description: "콘텐츠를 제작과정과 소소한 일상을 기록합니다.",
  },
];
---

<section class="ol-section">
  <div class="ol-container">
    <div class="ol-section-head">
      <span class="ol-section-label">READ · BORIDO</span>
      <h2 class="ol-kr">보리도가 만드는 불교콘텐츠</h2>
      <p>자료별 출처와 이용 조건을 확인해 주세요.</p>
    </div>
    <div class="ol-grid-3">
      {cards.map((card, i) => (
        <a href={url(card.href)} class="ol-product-card">
          <span class="ol-meta-label">
            0{i + 1} / {card.name}
          </span>
          <h3>{card.name}</h3>
          <p class="ol-kr">{card.description}</p>
          <div class="ol-product-foot">
            <span class="ol-meta-badge">
              {counts[i].filter((e) => e.data.kind !== "series").length}개 자료
            </span>
            <span>→</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
