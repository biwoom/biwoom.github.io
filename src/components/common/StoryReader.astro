---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ContentRights from "./ContentRights.astro";
import MaterialBody from "./MaterialBody.astro";
import { render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import {
  categoryUrl,
  entryUrl,
  type Entry,
  type Library,
  type Section,
} from "../../lib/library";
import { parsePrefixTag } from "../../lib/tags";
import { url } from "../../lib/url";
interface Props {
  entry: Entry;
  series: Library;
  section?: Section;
}
const { entry, series, section = "story" } = Astro.props;
const sectionLabel = section.toUpperCase();
const rendered = entry.data.format
  ? undefined
  : await render(entry as CollectionEntry<"text" | "story">);
const Content = rendered?.Content;
const headings = rendered?.headings ?? [];
const documentParts = series.parts.map((part) => ({
  ...part,
  slug: part.key,
  groups: [{ label: "", entries: part.entries }],
}));
const currentPartSlug = entry.data.partKey;
const currentPart = documentParts.find((part) => part.slug === currentPartSlug);
const chapterNumber =
  (currentPart?.entries.findIndex((item) => item.id === entry.id) ?? 0) + 1;
const currentIndex = series.entries.findIndex((item) => item.id === entry.id);
const prevEntry =
  currentIndex > 0 ? series.entries[currentIndex - 1] : undefined;
const nextEntry = series.entries[currentIndex + 1];
const currentUrl = entry.data.url;
const pagefindBreadcrumb = [
  sectionLabel,
  entry.data.category,
  series.label,
  entry.data.part,
]
  .filter(Boolean)
  .join(" · ");
const hasToc = headings.some(
  (heading) => heading.depth === 2 || heading.depth === 3,
);
---

<BaseLayout
  title={`${entry.data.title} — ${series?.label ?? entry.data.series ?? `BORIDO ${sectionLabel}`}`}
  lang={entry.data.lang}
  description={entry.data.description}
  pagefindMeta={{
    title: entry.data.title,
    section: sectionLabel,
    sectionLabel,
    category: entry.data.category,
    series: series?.label ?? entry.data.series,
    part: entry.data.part,
    breadcrumb: pagefindBreadcrumb,
  }}
>
  <main
    class="ol-story-reader-page ol-story-doc-page"
    data-reader-section={section}
  >
    <section class="ol-story-doc-hero">
      <div class="ol-text-breadcrumb">
        <a href={url(`/${section}`)}>{sectionLabel}</a>
        {entry.data.category && (
          <>
            <span>/</span>
            <a href={url(categoryUrl(series.categoryKey))}>{entry.data.category}</a>
          </>
        )}
        <span>/</span>
        <a href={series.url}>{series?.label ?? entry.data.series}</a>
        {entry.data.part && (
          <>
            <span>/</span>
            <span>{entry.data.part}</span>
          </>
        )}
      </div>

      <h1 class="ol-kr">{entry.data.title}</h1>
      {entry.data.description && <p class="ol-kr">{entry.data.description}</p>}
    </section>

    {documentParts.length > 0 && (
      <nav
        class="ol-story-part-nav"
        aria-label={`${series.label} ${section === "text" ? "자료 구분" : "파트"} 바로가기`}
      >
        {documentParts.map((part, index) => {
          const firstEntry = part.entries[0];
          return (
            <a
              href={url(entryUrl(firstEntry))}
              class:list={{ active: part.slug === currentPartSlug }}
            >
              <span>
                {section === "text" ? "자료 구분" : "PART"} {index + 1}
              </span>
              <strong class="ol-kr">{part.label}</strong>
            </a>
          );
        })}
      </nav>
    )}

    <section class="ol-story-reader-shell">
      <div class="ol-story-part-layout">
        <aside class="ol-story-part-sidebar" data-pagefind-ignore>
          <div class="ol-story-part-sidebar-head">
            <span>{section === "text" ? "자료 구분" : "PART"}</span>
            <strong class="ol-kr">
              {currentPart?.label ?? entry.data.part}
            </strong>
          </div>
          <nav aria-label={`${currentPart?.label ?? entry.data.part} 목차`}>
            {currentPart?.groups.map((group) => (
              <section class="ol-story-sidebar-group">
                {group.label && <h3 class="ol-kr">{group.label}</h3>}
                {group.entries.map((item, itemIndex) => (
                  <a
                    href={url(entryUrl(item))}
                    class:list={{ active: item.id === entry.id }}
                  >
                    <span>{String(itemIndex + 1).padStart(2, "0")}</span>
                    <strong class="ol-kr">{item.data.title}</strong>
                  </a>
                ))}
              </section>
            ))}
          </nav>
        </aside>

        <article class="ol-story-part-content" data-pagefind-body>
          <div class="ol-reader-toolbar">
            <div class="ol-story-part-tools">
              {hasToc && (
                <button class="ol-text-tool-btn ol-reader-toc-trigger" type="button"
                  aria-label="문서 목차 열기" title="문서 목차" aria-haspopup="dialog"
                  aria-expanded="false" aria-controls="ol-reader-toc" data-reader-toc-trigger>
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
                    stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path d="M8 6h13M8 12h13M8 18h13M3 6h1M3 12h1M3 18h1" />
                  </svg>
                  <span class="ol-text-tool-label ol-reader-toc-label">목차</span>
                </button>
              )}
              <div
                class="ol-copy-dropdown"
                data-copy-dropdown
                data-copy-url={currentUrl}
                data-copy-title={entry.data.title}
              >
                <button
                  class="ol-text-tool-btn"
                  type="button"
                  aria-expanded="false"
                >
                  <svg
                    width="14"
                    height="14"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    aria-hidden="true"
                  >
                    <rect x="9" y="9" width="11" height="11" rx="2" />
                    <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
                  </svg>
                  <span class="ol-text-tool-label">Copy</span>
                </button>
                <div class="ol-copy-panel">
                  <button type="button" data-copy-kind="link">
                    링크 복사
                  </button>
                  <button type="button" data-copy-kind="markdown">
                    마크다운 복사
                  </button>
                </div>
              </div>
            </div>

            <div class="ol-story-mobile-controls" data-story-mobile-controls>
              <div class="ol-story-mobile-chapters" data-story-mobile-chapters>
                <button
                  class="ol-text-tool-btn"
                  type="button"
                  aria-expanded="false"
                >
                  <svg
                    width="15"
                    height="15"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    aria-hidden="true"
                  >
                    <line x1="8" y1="6" x2="21" y2="6" />
                    <line x1="8" y1="12" x2="21" y2="12" />
                    <line x1="8" y1="18" x2="21" y2="18" />
                    <line x1="3" y1="6" x2="3.01" y2="6" />
                    <line x1="3" y1="12" x2="3.01" y2="12" />
                    <line x1="3" y1="18" x2="3.01" y2="18" />
                  </svg>
                  <span class="sr-only">목록</span>
                </button>
                <div class="ol-story-mobile-chapters-panel">
                  <div class="ol-story-mobile-info-links">
                    {currentPart?.groups.map((group) => (
                      <>
                        {group.label && <h3 class="ol-kr">{group.label}</h3>}
                        {group.entries.map((item, itemIndex) => (
                          <a
                            href={url(entryUrl(item))}
                            class:list={{ active: item.id === entry.id }}
                          >
                            <span>
                              {String(itemIndex + 1).padStart(2, "0")}
                            </span>
                            <strong class="ol-kr">{item.data.title}</strong>
                          </a>
                        ))}
                      </>
                    ))}
                  </div>
                </div>
              </div>
            </div>
          </div>

          <header class="ol-story-part-content-head">
            <div>
              <span class="ol-section-label">
                {currentPart?.label ?? entry.data.part} ·{" "}
                {section === "text" ? "자료" : "CHAPTER"}{" "}
                {String(chapterNumber).padStart(2, "0")}
              </span>
              <h2 class="ol-kr">{entry.data.title}</h2>
            </div>
          </header>

          <div class="ol-story-active-doc-actions">
            <div class="ol-text-doc-meta">
              <span class="ol-meta-label">
                {entry.data.date &&
                  new Date(entry.data.date).toLocaleDateString("ko-KR", {
                    year: "numeric",
                    month: "long",
                    day: "numeric",
                  })}
              </span>
            </div>
          </div>

          {entry.data.tags.length > 0 && (
            <div class="ol-story-active-doc-tags">
              {entry.data.tags.map((tag) => {
                const parsed = parsePrefixTag(tag);
                return (
                  <span class="ol-text-tag">
                    <span>{parsed.prefix}</span>
                    <strong>{parsed.label}</strong>
                  </span>
                );
              })}
            </div>
          )}

          <div class="ol-story-chapter active">
            <div class="ol-prose ol-kr">
              <MaterialBody entry={entry}>
                {Content && <Content />}
              </MaterialBody>
            </div>
          </div>

          <ContentRights data={entry.data} />
          {(prevEntry || nextEntry) && (
            <nav class="ol-doc-nav" aria-label="이전 다음 문서">
              {prevEntry ? (
                <a
                  class="ol-doc-nav-item ol-doc-nav-item--prev"
                  href={url(entryUrl(prevEntry))}
                >
                  <span class="ol-doc-nav-kicker">이전 문서</span>
                  <strong class="ol-kr">{prevEntry.data.title}</strong>
                </a>
              ) : (
                <span class="ol-doc-nav-spacer" />
              )}
              {nextEntry ? (
                <a
                  class="ol-doc-nav-item ol-doc-nav-item--next"
                  href={url(entryUrl(nextEntry))}
                >
                  <span class="ol-doc-nav-kicker">다음 문서</span>
                  <strong class="ol-kr">{nextEntry.data.title}</strong>
                </a>
              ) : (
                <span class="ol-doc-nav-spacer" />
              )}
            </nav>
          )}
        </article>
      </div>
    </section>
    {hasToc && (
      <dialog id="ol-reader-toc" class="ol-reader-toc" aria-labelledby="ol-reader-toc-title" data-pagefind-ignore>
        <section class="ol-reader-toc-panel">
          <header class="ol-reader-toc-head">
            <h2 id="ol-reader-toc-title">문서 목차</h2>
            <button type="button" class="ol-text-tool-btn" aria-label="목차 닫기" data-reader-toc-close autofocus>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="m6 6 12 12M6 18 18 6" />
              </svg>
            </button>
          </header>
          <nav aria-label="문서 내 제목"><ul data-story-toc-list>
            {headings.filter((heading) => heading.depth === 2 || heading.depth === 3).map((heading) => (
              <li><a href={`#${heading.slug}`} data-level={heading.depth}>{heading.text}</a></li>
            ))}
          </ul></nav>
        </section>
      </dialog>
    )}
  </main>
</BaseLayout>

<script>
  const normalizeMarkdown = (value: string) =>
    value
      .replace(/\n{3,}/g, "\n\n")
      .replace(/[ \t]+\n/g, "\n")
      .trim();

  const getStoryMarkdown = (title: string) => {
    const source = document.querySelector<HTMLElement>(".ol-prose");
    const body = normalizeMarkdown(source?.innerText ?? "");
    return normalizeMarkdown(`# ${title}\n\n${body}`);
  };

  const initToc = () => {
    const drawer = document.querySelector<HTMLDialogElement>("#ol-reader-toc");
    const trigger = document.querySelector<HTMLButtonElement>("[data-reader-toc-trigger]");
    if (!drawer || !trigger) return;
    const links = Array.from(drawer.querySelectorAll<HTMLAnchorElement>("[data-story-toc-list] a"));
    const headings = links.map((link) => document.getElementById(decodeURIComponent(link.hash.slice(1))))
      .filter((heading): heading is HTMLElement => heading !== null);
    let closing = false;
    let previousOverflow = "";
    const closeDrawer = (destination?: HTMLElement) => {
      if (!drawer.open || closing) return;
      closing = true;
      drawer.classList.remove("is-open");
      trigger.setAttribute("aria-expanded", "false");
      const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      window.setTimeout(() => {
        drawer.close();
        document.body.style.overflow = previousOverflow;
        closing = false;
        trigger.focus({ preventScroll: true });
        if (destination) {
          window.location.hash = encodeURIComponent(destination.id);
          destination.scrollIntoView({ block: "start" });
        }
      }, reducedMotion ? 0 : 200);
    };
    trigger.addEventListener("click", () => {
      if (drawer.open) { closeDrawer(); return; }
      previousOverflow = document.body.style.overflow;
      document.body.style.overflow = "hidden";
      drawer.showModal();
      trigger.setAttribute("aria-expanded", "true");
      requestAnimationFrame(() => requestAnimationFrame(() => drawer.classList.add("is-open")));
    });
    drawer.querySelector("[data-reader-toc-close]")?.addEventListener("click", () => closeDrawer());
    drawer.addEventListener("cancel", (event) => { event.preventDefault(); closeDrawer(); });
    drawer.addEventListener("click", (event) => {
      if (event.target === drawer) closeDrawer();
    });
    links.forEach((link) => link.addEventListener("click", (event) => {
      const heading = document.getElementById(decodeURIComponent(link.hash.slice(1)));
      if (!heading) return;
      event.preventDefault();
      closeDrawer(heading);
    }));
    const syncActiveLinks = () => {
      const active = headings.filter((heading) => heading.getBoundingClientRect().top <= 160).at(-1) ?? headings[0];
      links.forEach((link) => {
        const selected = decodeURIComponent(link.hash.slice(1)) === active?.id;
        link.classList.toggle("active", selected);
        if (selected) link.setAttribute("aria-current", "location");
        else link.removeAttribute("aria-current");
      });
    };
    let scheduled = false;
    window.addEventListener("scroll", () => {
      if (scheduled) return;
      scheduled = true;
      requestAnimationFrame(() => { syncActiveLinks(); scheduled = false; });
    }, { passive: true });
    syncActiveLinks();
  };

  const closeMobilePanels = () => {
    document.querySelector<HTMLButtonElement>("[data-story-mobile-chapters] > button")
      ?.setAttribute("aria-expanded", "false");
  };
  const chapterTrigger = document.querySelector<HTMLButtonElement>("[data-story-mobile-chapters] > button");
  chapterTrigger?.addEventListener("click", (event) => {
    event.stopPropagation();
    chapterTrigger.setAttribute("aria-expanded", String(chapterTrigger.getAttribute("aria-expanded") !== "true"));
  });

  document
    .querySelectorAll<HTMLElement>("[data-copy-dropdown]")
    .forEach((dropdown) => {
      const trigger = dropdown.querySelector<HTMLButtonElement>("button");
      if (!trigger) return;
      trigger.addEventListener("click", (event) => {
        event.stopPropagation();
        const open = trigger.getAttribute("aria-expanded") === "true";
        trigger.setAttribute("aria-expanded", String(!open));
      });
    });

  document.addEventListener("click", async (event) => {
    const copyButton = (event.target as HTMLElement).closest<HTMLButtonElement>(
      "[data-copy-kind]",
    );
    if (copyButton) {
      event.stopPropagation();
      const dropdown = copyButton.closest<HTMLElement>("[data-copy-dropdown]");
      const title = dropdown?.dataset.copyTitle ?? document.title;
      const href = new URL(
        dropdown?.dataset.copyUrl ?? window.location.pathname,
        window.location.origin,
      ).href;
      const value =
        copyButton.dataset.copyKind === "markdown"
          ? getStoryMarkdown(title)
          : href;
      await navigator.clipboard?.writeText(value);
      const original = copyButton.textContent ?? "";
      copyButton.textContent = "복사됨";
      dropdown
        ?.querySelector<HTMLButtonElement>("button")
        ?.setAttribute("aria-expanded", "false");
      window.setTimeout(() => {
        copyButton.textContent = original;
      }, 1200);
      return;
    }

    document
      .querySelectorAll<HTMLButtonElement>("[data-copy-dropdown] > button")
      .forEach((button) => {
        button.setAttribute("aria-expanded", "false");
      });
    closeMobilePanels();
  });

  initToc();
</script>
