---
// Astro's Markdown renderer emits its footnote section last. Extract it during
// server rendering so IDs, rich markup and backreferences have one destination.
const html = await Astro.slots.render("default");
const notes = html.match(/<section\b[^>]*\bdata-footnotes(?:="[^"]*")?[^>]*>[\s\S]*<\/section>\s*$/);
const body = notes ? html.slice(0, notes.index) : html;
---
<div class="ol-prose ol-kr" set:html={body} />
{notes && (
  <dialog id="ol-reader-footnotes" class="ol-reader-toc ol-reader-footnotes" aria-labelledby="ol-reader-footnotes-title" data-pagefind-ignore>
    <section class="ol-reader-toc-panel">
      <header class="ol-reader-toc-head">
        <h2 id="ol-reader-footnotes-title">문서 각주</h2>
        <button type="button" class="ol-text-tool-btn" aria-label="각주 닫기" data-reader-footnotes-close autofocus>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 6 12 12M6 18 18 6" /></svg>
        </button>
      </header>
      <div class="ol-reader-footnotes-content ol-prose" set:html={notes[0]} />
    </section>
  </dialog>
)}
