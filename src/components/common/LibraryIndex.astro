---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getLibrary } from "../../lib/library";
import type { Section } from "../../lib/library";
interface Props {
  section: Section;
}
const { section } = Astro.props;
const library = await getLibrary(section);
const categories = [...new Set(library.map((s) => s.category).filter(Boolean))];
---

<BaseLayout
  title={`BORIDO ${section.toUpperCase()}`}
  description={
    section === "text"
      ? "불교 문헌의 번역·연구·시각자료"
      : "불교의 인물과 가르침을 만나는 이야기"
  }
  pagefindBody={false}
>
  <main>
    <section
      class={`ol-hero ol-grid-bg ol-grid-bg--${section} ol-hero--compact`}
    >
      <div class="ol-container">
        <span class="ol-section-label">BORIDO {section.toUpperCase()}</span>
        <h1 class="ol-kr">
          {section === "text"
            ? "불교 문헌을 읽고 연구하다."
            : "이야기로 만나는 불교."}
        </h1>
        <p class="ol-lead ol-kr">
          {section === "text"
            ? "문헌별 번역과 연구, 시각자료를 함께 살펴보세요."
            : "인물과 설화, 가르침을 이야기로 읽어보세요."}
        </p>
      </div>
    </section>
    <section class="ol-section">
      <div class="ol-container">
        {categories.length > 0 && (
          <nav class="ol-category-filter" aria-label="문헌 카테고리">
            <button type="button" data-category="" aria-pressed="true">
              전체
            </button>
            {categories.map((c) => (
              <button type="button" data-category={c} aria-pressed="false">
                {c}
              </button>
            ))}
          </nav>
        )}
        <div class="ol-grid-2" data-library-grid>
          {library.map((series) => (
            <a
              class="ol-card ol-story-library-card"
              href={series.url}
              data-library-category={series.category}
            >
              <span class="ol-meta-label">
                {series.category || section.toUpperCase()} · {series.count}개
                자료
              </span>
              <h2 class="ol-kr">{series.label}</h2>
              {series.description && <p>{series.description}</p>}
              <span class="ol-meta-label">
                {series.parts.map((p) => p.label).join(" · ")}
              </span>
            </a>
          ))}
        </div>
        <div class="ol-loadmore-wrap" data-library-more hidden>
          <button
            type="button"
            class="ol-btn ol-btn-ghost"
            data-library-more-button
          >
            더 보기 <span data-library-remaining></span>
          </button>
        </div>
        {library.length === 0 && <p>준비 중입니다.</p>}
      </div>
    </section>
  </main>
</BaseLayout>
<script>
  import { createPaginator } from "../../lib/client/paginated-list";
  const cards = [
    ...document.querySelectorAll<HTMLElement>("[data-library-category]"),
  ];
  const paginator = createPaginator({
    allItems: cards,
    pageSize: 8,
    loadMoreWrap: document.querySelector("[data-library-more]"),
    loadMoreButton: document.querySelector("[data-library-more-button]"),
    loadMoreRemaining: document.querySelector("[data-library-remaining]"),
  });
  paginator.reset();
  for (const button of document.querySelectorAll<HTMLButtonElement>(
    "[data-category]",
  ))
    button.addEventListener("click", () => {
      const category = button.dataset.category;
      for (const b of document.querySelectorAll("[data-category]"))
        b.setAttribute("aria-pressed", String(b === button));
      paginator.reset(
        cards.filter(
          (card) => !category || card.dataset.libraryCategory === category,
        ),
      );
    });
</script>
