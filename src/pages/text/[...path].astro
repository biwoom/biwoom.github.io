---
import { render } from "astro:content";
import { getLibrary } from "../../lib/library";
import TextLibrary from "../../components/common/TextLibrary.astro";
import TextReader from "../../components/common/TextReader.astro";
export async function getStaticPaths() {
  const library = await getLibrary("text");
  return library.flatMap((series) => [
    {
      params: {
        path: decodeURI(series.url.replace(/^\/text\//, "").replace(/\/$/, "")),
      },
      props: { series },
    },
    ...series.entries.map((entry) => ({
      params: {
        path: decodeURI(
          entry.data.url.replace(/^\/text\//, "").replace(/\/$/, ""),
        ),
      },
      props: { series, entry },
    })),
  ]);
}
const { series, entry } = Astro.props;
const Intro =
  !entry && series.meta ? (await render(series.meta)).Content : undefined;
---

{entry ? (
  <TextReader entry={entry} series={series} />
) : (
  <TextLibrary series={series}>
    {Intro && (
      <div class="ol-prose">
        <Intro />
      </div>
    )}
  </TextLibrary>
)}
