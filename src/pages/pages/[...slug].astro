---
import { getCollection, render } from "astro:content";
import ContentRights from "../../components/common/ContentRights.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { url } from "../../lib/url";

export async function getStaticPaths() {
  const pages = await getCollection("pages", (e) => e.data.published);
  return pages.map((entry) => ({
    params: {
      slug: entry.data.url.replace(/^\/pages\//, "").replace(/\/$/, ""),
    },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<BaseLayout
  title={`${entry.data.title} — BORIDO`}
  description={entry.data.description}
>
  <main>
    <section class="ol-section">
      <div class="ol-container ol-container--readable">
        <header class="ol-page-header">
          <h1 class="ol-page-heading ol-kr">{entry.data.title}</h1>
          {entry.data.description && (
            <p class="ol-page-description ol-kr">{entry.data.description}</p>
          )}
        </header>
        <div class="ol-prose">
          <Content />
        </div>
        <ContentRights data={entry.data} />
        <footer class="ol-page-return">
          <a href={url("/")} class="ol-page-return-link">
            ← 홈으로
          </a>
        </footer>
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  document.querySelectorAll<HTMLElement>('[data-donation-account]').forEach((account) => {
    const button = account.querySelector<HTMLButtonElement>('[data-copy-account]');
    const text = account.querySelector<HTMLElement>('[data-account-text]');
    const status = account.querySelector<HTMLElement>('[data-account-status]');
    if (!button || !text || !status) return;

    button.addEventListener('click', async () => {
      button.disabled = true;
      status.textContent = '';
      try {
        await navigator.clipboard.writeText(text.textContent?.trim() ?? '');
        status.textContent = '복사했습니다.';
      } catch {
        status.textContent = '복사하지 못했습니다. 계좌를 선택해 직접 복사해 주세요.';
      } finally {
        button.disabled = false;
      }
    });
  });
</script>

<style>
  :global(.document-changelog > summary) {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    cursor: pointer;
    list-style: none;
    font-weight: 600;
  }

  :global(.document-changelog > summary::-webkit-details-marker) {
    display: none;
  }

  :global(.document-changelog > summary:focus-visible) {
    outline: 2px solid currentColor;
    outline-offset: 4px;
  }

  :global(.document-changelog-arrow) {
    display: inline-block;
    font-size: 1.5em;
    line-height: 1;
  }

  :global(.document-changelog[open] > summary .document-changelog-arrow) {
    transform: rotate(90deg);
  }

  :global(.donation-account) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.75rem;
    margin-block: 1.25em;
  }

  :global(.donation-account-status) {
    flex-basis: 100%;
    font-size: 0.875em;
  }

  :global(.donation-account-status:empty) {
    display: none;
  }
</style>
