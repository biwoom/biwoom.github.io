---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getBlogThumbnailUrl } from "../../lib/assets";
import { getBlogTags } from "../../lib/tags";

const posts = await getCollection("blog", (e) => e.data.published);
posts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const thumbnails = Object.fromEntries(
  posts.map((post) => [post.id, getBlogThumbnailUrl(post)]),
);

const PAGE_SIZE = 6;

const tagFilters = getBlogTags(posts.map((post) => ({ tags: post.data.tags })));

const archiveYears = [
  ...new Set(posts.map((p) => p.data.date.getFullYear())),
].sort((a, b) => b - a);
---

<BaseLayout
  title="BORIDO BLOG — 작업 일지"
  description="보리도의 결정 기록. 무엇을 고쳤고, 무엇을 포기했고, 무엇을 다음으로 미뤘는지."
  pagefindBody={false}
>
  <main>
    <!-- Hero -->
    <section class="ol-hero ol-grid-bg ol-grid-bg--blog ol-hero--compact">
      <div class="ol-container">
        <span class="ol-section-label">JOURNAL · 일지</span>
        <h1 class="ol-kr">
          소소한 일상의 기록
          <br />
        </h1>
        <p class="ol-lead ol-kr">
          보리도 BLOG는 콘텐츠 제작과정을 기록하고 소소한 일상을 공유하는 공간입니다.
        </p>
      </div>
    </section>

    <!-- Filter + posts -->
    <section class="ol-section-tight">
      <div class="ol-container">
        <div class="ol-row ol-blog-chip-row">
          <div class="ol-chips ol-blog-tag-chips" id="blog-chips" role="group" aria-label="태그로 글 분류">
            <button type="button" class="ol-chip active" data-blog-tag="" aria-pressed="true">
              전체 <span class="count">{posts.length}</span>
            </button>
            {tagFilters.map(({ tag, count }) => (
              <button type="button" class="ol-chip" data-blog-tag={tag} aria-pressed="false">
                {tag} <span class="count">{count}</span>
              </button>
            ))}
          </div>
        </div>
        <p class="ol-blog-filter-status" id="blog-filter-status" role="status" aria-live="polite">{posts.length}개 글</p>

        <div class="ol-section-grid-sidebar">
          <div>
            <div id="blog-posts">
              {posts.length === 0 ? (
                <div class="ol-blog-empty">아직 발행된 글이 없습니다.</div>
              ) : (
                posts.map((post, i) => {
                  const hasThumbnail = !!thumbnails[post.id];
                  return (
                    <article
                      class:list={[
                        "ol-post",
                        { "ol-post--text-only": !hasThumbnail },
                      ]}
                      data-tags={JSON.stringify(post.data.tags)}
                      data-year={post.data.date.getFullYear()}
                      data-index={i}
                      hidden={i >= PAGE_SIZE}
                    >
                      {hasThumbnail && (
                        <div>
                          <div class="when">
                            {post.data.date
                              .toLocaleDateString("ko-KR", {
                                year: "numeric",
                                month: "2-digit",
                                day: "2-digit",
                              })
                              .replace(/\. /g, " · ")
                              .replace(".", "")}
                          </div>
                          {post.data.category && (
                            <span class="ol-badge ol-blog-card-badge">
                              {post.data.category}
                            </span>
                          )}
                          <div class="ol-blog-card-media">
                            <a
                              href={post.data.url}
                              class="ol-blog-card-media-link"
                            >
                              <div class="ol-blog-card-thumb-frame">
                                <img
                                  src={thumbnails[post.id]}
                                  alt={post.data.title}
                                  class="ol-blog-card-thumb-image"
                                />
                              </div>
                            </a>
                          </div>
                        </div>
                      )}
                      <div>
                        {!hasThumbnail && (
                          <div class="ol-blog-card-meta-row">
                            <div class="when">
                              {post.data.date
                                .toLocaleDateString("ko-KR", {
                                  year: "numeric",
                                  month: "2-digit",
                                  day: "2-digit",
                                })
                                .replace(/\. /g, " · ")
                                .replace(".", "")}
                            </div>
                            {post.data.category && (
                              <span class="ol-badge">{post.data.category}</span>
                            )}
                          </div>
                        )}
                        <a href={post.data.url} class="ol-post-title-link">
                          <h3 class="ol-kr">{post.data.title}</h3>
                        </a>
                        <p class="ol-kr">{post.data.description}</p>
                        {post.data.readingTime && (
                          <div class="meta">
                            <span>{post.data.readingTime}분 읽기</span>
                          </div>
                        )}
                        <a class="read" href={post.data.url}>
                          전문 읽기 →
                        </a>
                      </div>
                    </article>
                  );
                })
              )}
            </div>

            <div id="blog-no-results" class="ol-kr ol-blog-empty" hidden>
              선택한 필터에 해당하는 글이 없습니다.
            </div>

            {posts.length > PAGE_SIZE && (
              <div class="ol-blog-loadmore" id="blog-loadmore-wrap" hidden>
                <button id="blog-loadmore-btn" class="ol-btn ol-btn-outline">
                  더 보기
                  <span id="blog-loadmore-remaining">
                    ({posts.length - PAGE_SIZE})
                  </span>
                </button>
              </div>
            )}
          </div>

          <!-- Sidebar -->
          <aside class="ol-blog-sidebar">
            <div class="ol-card ol-blog-archive-card">
              <div class="ol-meta-label">ARCHIVE</div>
              <div class="ol-blog-archive-list" id="blog-archive">
                <button type="button" class="ol-blog-archive-btn active" data-year="all" aria-pressed="true">
                  <span class="ol-kr">전체</span>
                  <span class="ol-blog-archive-count">{posts.length}</span>
                </button>
                {archiveYears.map((year) => (
                  <button type="button" class="ol-blog-archive-btn" data-year={String(year)} aria-pressed="false">
                    <span class="ol-kr">{year}년</span>
                    <span class="ol-blog-archive-count">
                      {
                        posts.filter((p) => p.data.date.getFullYear() === year)
                          .length
                      }
                    </span>
                  </button>
                ))}
              </div>
            </div>
          </aside>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  import { createPaginator } from "../../lib/client/paginated-list";
  import { matchesBlogFilters } from "../../lib/tags";

  let activeTag = new URLSearchParams(window.location.search).get("tag") ?? "";
  let activeYear = "all";
  const posts = [...document.querySelectorAll<HTMLElement>("#blog-posts .ol-post")];
  const tagButtons = [...document.querySelectorAll<HTMLButtonElement>("#blog-chips [data-blog-tag]")];
  const yearButtons = [...document.querySelectorAll<HTMLButtonElement>(".ol-blog-archive-btn")];
  const noResults = document.getElementById("blog-no-results")!;
  const status = document.getElementById("blog-filter-status")!;
  const paginator = createPaginator({
    allItems: posts,
    pageSize: 6,
    loadMoreWrap: document.getElementById("blog-loadmore-wrap"),
    loadMoreButton: document.querySelector<HTMLButtonElement>("#blog-loadmore-btn"),
    loadMoreRemaining: document.getElementById("blog-loadmore-remaining"),
    onRender: ({ matchedItems }) => {
      noResults.hidden = matchedItems.length !== 0;
      status.textContent = `${matchedItems.length}개 글`;
    },
  });

  function applyFilters() {
    for (const button of tagButtons) {
      const selected = (button.dataset.blogTag ?? "") === activeTag;
      button.classList.toggle("active", selected);
      button.setAttribute("aria-pressed", String(selected));
    }
    for (const button of yearButtons) {
      const selected = button.dataset.year === activeYear;
      button.classList.toggle("active", selected);
      button.setAttribute("aria-pressed", String(selected));
    }
    paginator.reset(posts.filter((post) => matchesBlogFilters({
      tags: JSON.parse(post.dataset.tags ?? "[]") as string[],
      year: post.dataset.year ?? "",
    }, activeTag, activeYear)));
  }

  for (const button of tagButtons) button.addEventListener("click", () => {
    activeTag = button.dataset.blogTag ?? "";
    const href = new URL(window.location.href);
    if (activeTag) href.searchParams.set("tag", activeTag);
    else href.searchParams.delete("tag");
    window.history.replaceState(null, "", href);
    applyFilters();
  });
  for (const button of yearButtons) button.addEventListener("click", () => {
    activeYear = button.dataset.year ?? "all";
    applyFilters();
  });
  window.addEventListener("popstate", () => {
    activeTag = new URLSearchParams(window.location.search).get("tag") ?? "";
    applyFilters();
  });
  applyFilters();
</script>
